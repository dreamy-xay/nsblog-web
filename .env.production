# 运行环境
NODE_ENV='production'

# devServer port
VUE_APP_PORT=8888

# mock 是否开启(true|false)，默认 development 环境为开启
VUE_APP_MOCK=false

# api接口域名
VUE_APP_APIHOST='http://152.136.51.92'

# api接口端口
VUE_APP_APIPORT=3000

# api接口路由
VUE_APP_APIROUTER='/v1'

# socket接口路由
VUE_APP_SOCKETROUTER='/socket'

# web网页访问前缀
VUE_APP_BASE_PREFIX="/nsblog-web"