# 运行环境
NODE_ENV='development'

# webpack devServer port
VUE_APP_PORT=8888

# mock 是否开启(true|false)，默认 development 环境为开启
VUE_APP_MOCK=true

# api接口域名
VUE_APP_APIHOST='http://127.0.0.1'

# api接口端口
VUE_APP_APIPORT=3000

# api接口路由
VUE_APP_APIROUTER='/v1'

# socket接口路由
VUE_APP_SOCKETROUTER='/socket'