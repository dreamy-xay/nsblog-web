# 路由模式，true|false，true为history，false为hash
VUE_APP_ROUTER_MODE=false

# 路由拦截模式，true|false，true为mock拦截模式，false为sever拦截模式，推荐使用sever
VUE_APP_MOCK_SEVER=false

# 路由拦截延迟范围 A-B
VUE_APP_MOCK_TIMEOUT='300-900'

# api请求打印调试，true|false，true为开始打印调试，false为不开启，推荐使用debug
VUE_APP_API_DEBUG=true

# 加密密钥 key(密钥: 16进制字符串)，iv(偏移量: 16进制字符串)，16位
VUE_APP_CRYPTO_KEY='12A349C57E80BDF6'
VUE_APP_CRYPTO_IV='49BD2A3F7E806C51'